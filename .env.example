# Google Cloud OAuth 2.0 Client ID (Web application)
VITE_GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com

# Google Cloud API Key (Restricted to Google Drive & Picker APIs)
VITE_GOOGLE_API_KEY=your_google_picker_api_key

# Google Cloud Project Number / App ID (Optional, used by Picker)
VITE_GOOGLE_APP_ID=your_google_project_number
